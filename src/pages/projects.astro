---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="All Projects">
  <Navbar />
  <main
    class="w-full overflow-x-hidden pt-[120px] pb-margin-desktop min-h-screen"
  >
    <section
      id="all-projects"
      class="px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto w-full"
    >
      <header
        class="mb-gutter md:mb-[64px] border-border-width border-on-surface bg-surface-container-lowest shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-gutter inline-block reveal-left mt-[80px]"
      >
        <h1 class="font-display-xl text-display-xl uppercase m-0 leading-none">
          All Projects
        </h1>
        <p
          class="font-mono-data text-mono-data mt-grid-unit text-on-surface-variant bg-primary-fixed border-[2px] border-on-surface inline-block px-2 py-1 shadow-[2px_2px_0px_rgba(0,0,0,1)]"
        >
          ARCHIVE // [05_RECORDS_FOUND]
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        <!-- Project Card 1: GAIS SJP -->
        <div class="reveal-left">
          <article
            class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
          >
            <div
              class="h-48 border-b-border-width border-on-surface overflow-hidden bg-primary-fixed"
            >
              <img
                class="w-full h-full object-cover transition-all duration-300"
                alt="GAIS SJP Project Thumbnail"
                src="/images/gais-sjp.jpg"
                onerror="this.src='https://placehold.co/600x400/0001BB/FFF?text=GAIS+SJP+ERP'"
              />
            </div>
            <div class="p-gutter flex flex-col flex-grow">
              <h2
                class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface"
              >
                GAIS SJP
              </h2>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow"
              >
                Sistem informasi Enterprise Resource Planning (ERP) internal PT Selamat Jaya Persada untuk manajemen siklus hidup aset, mutasi inventaris, peminjaman, pemeliharaan, dan depresiasi aset. Dibangun fullstack dengan integrasi QR Code camera scanner, query agregasi realtime, dan automated feature testing.
              </p>
              <div class="flex flex-wrap gap-2 mb-gutter">
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1"
                  >LARAVEL</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1"
                  >VUE 3 / INERTIA</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1"
                  >POSTGRESQL</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1"
                  >DOCKER</span
                >
              </div>
              <div
                class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit"
              >
                <span
                  class="flex-1 bg-surface-container-high text-on-surface border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex justify-center items-center gap-2 cursor-default select-none text-sm font-bold"
                >
                  <span class="material-symbols-outlined text-base">lock</span> Internal Enterprise System
                </span>
              </div>
            </div>
          </article>
        </div>

        <!-- Project Card 2: V-Track -->
        <div class="reveal-bottom" style="transition-delay: 150ms;">
          <article
            class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
          >
            <div
              class="h-48 border-b-border-width border-on-surface overflow-hidden bg-primary-fixed"
            >
              <img
                class="w-full h-full object-cover transition-all duration-300"
                alt="V-Track Project Thumbnail"
                src="/images/v-track.jpg"
                onerror="this.src='https://placehold.co/600x400/E5F570/000?text=V-Track'"
              />
            </div>
            <div class="p-gutter flex flex-col flex-grow">
              <h2
                class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface"
              >
                V-Track
              </h2>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow"
              >
                Aplikasi pelacakan dan monitoring modern dengan antarmuka
                dinamis. Memudahkan pemantauan data secara interaktif dan
                real-time untuk efisiensi sistem.
              </p>
              <div class="flex flex-wrap gap-2 mb-gutter">
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1"
                  >REACT / VITE</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1"
                  >TAILWIND</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1"
                  >SUPABASE</span
                >
              </div>
              <div
                class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit"
              >
                <a
                  href="https://v-track-six.vercel.app/"
                  target="_blank"
                  class="flex-1 bg-primary text-on-primary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-primary-fixed transition-all flex justify-center items-center gap-2 text-decoration-none"
                >
                  <span class="material-symbols-outlined">public</span> Live Demo
                </a>
              </div>
            </div>
          </article>
        </div>

        <!-- Project Card 3: SF.CREATIVA -->
        <div class="reveal-right" style="transition-delay: 300ms;">
          <article
            class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
          >
            <div
              class="h-48 border-b-border-width border-on-surface overflow-hidden bg-[#141414]"
            >
              <img
                class="w-full h-full object-cover transition-all duration-300"
                alt="SF.CREATIVA Project Thumbnail"
                src="/images/sf-creativa.jpg"
                onerror="this.src='https://placehold.co/600x400/D90429/FFF?text=SF.CREATIVA'"
              />
            </div>
            <div class="p-gutter flex flex-col flex-grow">
              <h2
                class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface"
              >
                SF.CREATIVA
              </h2>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow"
              >
                Landing page berkinerja tinggi untuk cafe & creative space SF.CREATIVA. Mengusung konsep Dark Brutalism & Punk Zine Editorial dengan filter menu dinamis, bento gallery, dan status buka-tutup otomatis real-time (WIB).
              </p>
              <div class="flex flex-wrap gap-2 mb-gutter">
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1"
                  >ASTRO</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1"
                  >TAILWIND</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-[#D90429] text-white px-2 py-1"
                  >DARK BRUTALISM</span
                >
              </div>
              <div
                class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit"
              >
                <a
                  href="https://sfcreativa.vercel.app/"
                  target="_blank"
                  class="flex-1 bg-[#D90429] text-white border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-[#b00320] transition-all flex justify-center items-center gap-2 text-decoration-none"
                >
                  <span class="material-symbols-outlined">public</span> Live Demo
                </a>
              </div>
            </div>
          </article>
        </div>

        <!-- Project Card 4: Hospital Route (A*) -->
        <div class="reveal-left">
          <article
            class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
          >
            <div
              class="h-48 border-b-border-width border-on-surface overflow-hidden bg-secondary-fixed"
            >
              <img
                class="w-full h-full object-cover transition-all duration-300"
                alt="Hospital Route Project Thumbnail"
                src="/images/rute-rs.jpg"
                onerror="this.src='https://placehold.co/600x400/F54260/000?text=Hospital+Route'"
              />
            </div>
            <div class="p-gutter flex flex-col flex-grow">
              <h2
                class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface"
              >
                Hospital Route (A*)
              </h2>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow"
              >
                Website pencarian rute terpendek menuju lokasi rumah sakit
                terdekat yang berada di Provinsi Bengkulu berbasis Algoritma A*
                (A-Star). Terintegrasi langsung dengan peta digital interaktif.
              </p>
              <div class="flex flex-wrap gap-2 mb-gutter">
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1"
                  >JAVASCRIPT</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1"
                  >ALGORITMA A*</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1"
                  >VALHALLA API</span
                >
              </div>
              <div
                class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit"
              >
                <a
                  href="https://go-pai.github.io/rute-rumah-sakit/"
                  target="_blank"
                  class="flex-1 bg-secondary text-on-secondary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-secondary-fixed hover:text-on-surface transition-all flex justify-center items-center gap-2 text-decoration-none"
                >
                  <span class="material-symbols-outlined">public</span> Live Demo
                </a>
              </div>
            </div>
          </article>
        </div>

        <!-- Project Card 5: SJP Company Profile -->
        <div class="reveal-bottom" style="transition-delay: 150ms;">
          <article
            class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
          >
            <div
              class="h-48 border-b-border-width border-on-surface overflow-hidden bg-primary-fixed"
            >
              <img
                class="w-full h-full object-cover transition-all duration-300"
                alt="SJP Company Profile Thumbnail"
                src="/images/sjp-compro.jpg"
                onerror="this.src='https://placehold.co/600x400/E5F570/000?text=SJP+Company+Profile'"
              />
            </div>
            <div class="p-gutter flex flex-col flex-grow">
              <h2
                class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface"
              >
                SJP Company Profile
              </h2>
              <p
                class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow"
              >
                Website Company Profile resmi untuk holding PT Selamat Jaya Persada dan 8 entitas anak usahanya. Menggunakan custom WordPress child theme, routing virtual dinamis, dan setup container Docker.
              </p>
              <div class="flex flex-wrap gap-2 mb-gutter">
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1"
                  >WORDPRESS</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1"
                  >PHP</span
                >
                <span
                  class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1"
                  >DOCKER</span
                >
              </div>
              <div
                class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit"
              >
                <a
                  href="https://profile.absenkusjp.com/"
                  target="_blank"
                  class="flex-1 bg-primary text-on-primary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-primary-fixed transition-all flex justify-center items-center gap-2 text-decoration-none"
                >
                  <span class="material-symbols-outlined">public</span> Live Demo
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>

      <div
        class="mt-8 flex justify-center reveal-bottom"
        style="transition-delay: 300ms;"
      >
        <a
          href="/#projects"
          class="bg-surface text-on-surface border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 px-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-secondary-fixed hover:text-on-surface transition-all inline-flex justify-center items-center gap-2 text-decoration-none"
        >
          <span class="material-symbols-outlined text-[1.2em]">arrow_back</span> Kembali
          ke Awal
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .reveal-left {
    opacity: 0;
    transform: translateX(-60px);
    transition: all 0.8s cubic-bezier(0.5, 0, 1, 1);
  }
  .reveal-right {
    opacity: 0;
    transform: translateX(60px);
    transition: all 0.8s cubic-bezier(0.5, 0, 1, 1);
  }
  .reveal-bottom {
    opacity: 0;
    transform: translateY(60px);
    transition: all 0.8s cubic-bezier(0.5, 0, 1, 1);
  }
  .reveal-left.active,
  .reveal-right.active,
  .reveal-bottom.active {
    opacity: 1;
    transform: translate(0);
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const observeProjects = () => {
    const reveals = document.querySelectorAll(
      "#all-projects .reveal-left, #all-projects .reveal-right, #all-projects .reveal-bottom",
    );
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          } else {
            entry.target.classList.remove("active");
          }
        });
      },
      { threshold: 0.1 },
    );

    reveals.forEach((reveal) => {
      observer.observe(reveal);
    });
  };

  document.addEventListener("DOMContentLoaded", observeProjects);
  document.addEventListener("astro:page-load", observeProjects);
</script>
