---
---
<section id="projects" class="pt-[120px] pb-margin-desktop px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto w-full">
    <header class="mb-gutter md:mb-[64px] border-border-width border-on-surface bg-surface-container-lowest shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-gutter inline-block reveal-left">
        <h1 class="font-display-xl text-display-xl uppercase m-0 leading-none">Projects</h1>
        <p class="font-mono-data text-mono-data mt-grid-unit text-on-surface-variant bg-primary-fixed border-[2px] border-on-surface inline-block px-2 py-1 shadow-[2px_2px_0px_rgba(0,0,0,1)]">SELECTED_WORKS // [03_RECORDS_FOUND]</p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
        
        <!-- Project Card 1: V-Track -->
        <div class="reveal-left">
        <article class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200">
            <div class="h-48 border-b-border-width border-on-surface overflow-hidden bg-primary-fixed">
                <!-- Gunakan onerror untuk menampilkan placeholder jika gambar asli belum ada -->
                <img class="w-full h-full object-cover transition-all duration-300" alt="V-Track Project Thumbnail" src="/images/v-track.jpg" onerror="this.src='https://placehold.co/600x400/E5F570/000?text=V-Track'"/>
            </div>
            <div class="p-gutter flex flex-col flex-grow">
                <h2 class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface">V-Track</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow">Aplikasi pelacakan dan monitoring modern dengan antarmuka dinamis. Memudahkan pemantauan data secara interaktif dan real-time untuk efisiensi sistem.</p>
                <div class="flex flex-wrap gap-2 mb-gutter">
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1">REACT / VITE</span>
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1">TAILWIND</span>
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1">SUPABASE</span>
                </div>
                <div class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit">
                    <a href="https://v-track-six.vercel.app/" target="_blank" class="flex-1 bg-primary text-on-primary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-primary-fixed transition-all flex justify-center items-center gap-2 text-decoration-none">
                        <span class="material-symbols-outlined">public</span> Live Demo
                    </a>
                </div>
            </div>
        </article>
        </div>

        <!-- Project Card 2: Rute Rumah Sakit -->
        <div class="reveal-bottom" style="transition-delay: 150ms;">
        <article class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200">
            <div class="h-48 border-b-border-width border-on-surface overflow-hidden bg-secondary-fixed">
                <img class="w-full h-full object-cover transition-all duration-300" alt="Hospital Route Project Thumbnail" src="/images/rute-rs.jpg" onerror="this.src='https://placehold.co/600x400/F54260/000?text=Hospital+Route'"/>
            </div>
            <div class="p-gutter flex flex-col flex-grow">
                <h2 class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface">Hospital Route (A*)</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow">Website pencarian rute terpendek menuju lokasi rumah sakit terdekat yang berada di Provinsi Bengkulu berbasis Algoritma A* (A-Star). Terintegrasi langsung dengan peta digital interaktif.</p>
                <div class="flex flex-wrap gap-2 mb-gutter">
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1">JAVASCRIPT</span>
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1">ALGORITMA A*</span>
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1">VALHALLA API</span>
                </div>
                <div class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit">
                    <a href="https://go-pai.github.io/rute-rumah-sakit/" target="_blank" class="flex-1 bg-secondary text-on-secondary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-secondary-fixed hover:text-on-surface transition-all flex justify-center items-center gap-2 text-decoration-none">
                        <span class="material-symbols-outlined">public</span> Live Demo
                    </a>
                </div>
            </div>
        </article>
        </div>

        <!-- Project Card 3: UMB Portal -->
        <div class="reveal-right" style="transition-delay: 300ms;">
        <article class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200">
            <div class="h-48 border-b-border-width border-on-surface overflow-hidden bg-tertiary-fixed">
                <img class="w-full h-full object-cover transition-all duration-300" alt="Informatics UMB Project Thumbnail" src="/images/umb-portal.jpg" onerror="this.src='https://placehold.co/600x400/96F2D7/000?text=Informatics+UMB'"/>
            </div>
            <div class="p-gutter flex flex-col flex-grow">
                <h2 class="font-headline-md text-headline-md font-bold uppercase mb-grid-unit text-on-surface">Informatics UMB</h2>
                <p class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow">Landing page resmi untuk Program Studi Teknik Informatika Universitas Muhammadiyah Bengkulu. Pusat informasi akademik dan pendaftaran mahasiswa baru.</p>
                <div class="flex flex-wrap gap-2 mb-gutter">
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-primary text-on-primary px-2 py-1">WORDPRESS</span>
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-secondary text-on-secondary px-2 py-1">PHP</span>
                    <span class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1">MYSQL</span>
                </div>
                <div class="flex gap-grid-unit mt-auto border-t-border-width border-on-surface pt-grid-unit">
                    <a href="https://ft-informatika.umb.ac.id" target="_blank" class="flex-1 bg-surface text-on-surface border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-tertiary-fixed transition-all flex justify-center items-center gap-2 text-decoration-none">
                        <span class="material-symbols-outlined">public</span> Live Demo
                    </a>
                </div>
            </div>
        </article>
        </div>

    </div>
</section>

<style>
    .reveal-left {
        opacity: 0;
        transform: translateX(-60px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal-right {
        opacity: 0;
        transform: translateX(60px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal-bottom {
        opacity: 0;
        transform: translateY(60px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal-left.active, .reveal-right.active, .reveal-bottom.active {
        opacity: 1;
        transform: translate(0);
    }
</style>

<script>
    // Intersection Observer for scroll animations
    const observeProjects = () => {
        const reveals = document.querySelectorAll("#projects .reveal-left, #projects .reveal-right, #projects .reveal-bottom");
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("active");
                } else {
                    entry.target.classList.remove("active");
                }
            });
        }, { threshold: 0.1 });
        
        reveals.forEach(reveal => {
            observer.observe(reveal);
        });
    };

    document.addEventListener("DOMContentLoaded", observeProjects);
    document.addEventListener("astro:page-load", observeProjects);
</script>
