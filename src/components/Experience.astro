---
---
<section id="experience" class="w-full max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-margin-desktop relative">
    <!-- Page Header -->
    <header class="mb-margin-desktop border-[4px] border-on-surface bg-surface-container-lowest p-gutter shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] relative overflow-hidden">
        <!-- Drafting Box Crosshairs (Top Left) -->
        <div class="absolute top-0 left-0 w-4 h-4 border-r-[2px] border-b-[2px] border-on-surface"></div>
        <!-- Drafting Box Crosshairs (Bottom Right) -->
        <div class="absolute bottom-0 right-0 w-4 h-4 border-l-[2px] border-t-[2px] border-on-surface"></div>
        
        <h1 class="font-display-xl text-display-xl text-on-surface uppercase mb-4 reveal">EXPERIENCE</h1>
        <p class="font-mono-data text-mono-data text-on-surface-variant max-w-2xl bg-secondary-fixed p-2 inline-block border-[2px] border-on-surface">LOGGED ENTRIES: CHRONOLOGICAL_DESCENDING_ORDER</p>
    </header>

    <!-- Timeline Container -->
    <div class="relative w-full py-8">
        <!-- Central Stem -->
        <div class="absolute left-[16px] md:left-1/2 top-0 bottom-0 w-[8px] bg-on-surface -translate-x-1/2 z-0"></div>

        <!-- Timeline Item 1: Right Side (Desktop) -->
        <div class="relative flex md:justify-end items-center w-full mb-16 pl-12 md:pl-0 z-10 group reveal">
            <!-- Stem Connector -->
            <div class="absolute left-[16px] md:left-1/2 w-8 md:w-16 h-[8px] bg-on-surface md:-translate-x-full"></div>
            <!-- Node Marker -->
            <div class="absolute left-[16px] md:left-1/2 w-6 h-6 bg-primary border-[4px] border-on-surface rounded-none -translate-x-1/2 -translate-y-1/2 top-1/2 z-20 group-hover:bg-secondary-fixed transition-colors"></div>
            
            <div class="w-full md:w-[calc(50%-48px)] bg-surface-container-lowest border-[4px] border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] neo-interactive cursor-default hover:bg-surface-bright">
                <div class="border-b-[4px] border-on-surface p-4 bg-primary-fixed">
                    <div class="flex justify-between items-start flex-wrap gap-2">
                        <h3 class="font-headline-md text-headline-md font-bold text-on-surface uppercase">Web Developer</h3>
                        <span class="font-label-caps text-label-caps bg-on-surface text-surface-container-lowest px-2 py-1">PROJECT</span>
                    </div>
                    <h4 class="font-body-lg text-body-lg text-on-surface-variant mt-2">Universitas Muhammadiyah Bengkulu</h4>
                </div>
                <div class="p-4 bg-surface-container-lowest">
                    <ul class="space-y-3">
                        <li class="font-body-md text-body-md text-on-surface flex items-start border-b-[4px] border-on-surface pb-2 border-opacity-20 hover:bg-secondary-fixed transition-colors">
                            <span class="material-symbols-outlined mr-2 shrink-0 fill" style="font-variation-settings: 'FILL' 1;" data-icon="square">square</span>
                            Mengembangkan website landing page informasi untuk program studi Teknik Informatika menggunakan WordPress.
                        </li>
                    </ul>
                    <div class="mt-4 flex flex-wrap gap-4">
                        <a href="https://ft-informatika.umb.ac.id/" target="_blank" class="bg-primary text-on-primary border-[2px] border-on-surface shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] px-4 py-2 font-bold no-underline hover:bg-primary-fixed hover:text-on-surface transition-colors uppercase text-sm">
                            Kunjungi Website
                        </a>
                    </div>
                    <div class="mt-6 flex flex-wrap gap-2">
                        <span class="font-label-caps text-label-caps bg-primary text-on-primary border-[2px] border-on-surface px-2 py-1">WordPress</span>
                        <span class="font-label-caps text-label-caps bg-primary text-on-primary border-[2px] border-on-surface px-2 py-1">CMS</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline Item 2: Left Side (Desktop) -->
        <div class="relative flex md:justify-start items-center w-full mb-16 pl-12 md:pl-0 z-10 group reveal" style="transition-delay: 200ms;">
            <!-- Stem Connector -->
            <div class="absolute left-[16px] md:left-[calc(50%+16px)] md:w-16 h-[8px] bg-on-surface hidden md:block"></div>
            <div class="absolute left-[16px] w-8 h-[8px] bg-on-surface md:hidden"></div>
            <!-- Node Marker -->
            <div class="absolute left-[16px] md:left-1/2 w-6 h-6 bg-surface border-[4px] border-on-surface rounded-none -translate-x-1/2 -translate-y-1/2 top-1/2 z-20 group-hover:bg-secondary-fixed transition-colors"></div>
            
            <div class="w-full md:w-[calc(50%-48px)] bg-surface-container-lowest border-[4px] border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] neo-interactive cursor-default hover:bg-surface-bright">
                <div class="border-b-[4px] border-on-surface p-4 bg-secondary-fixed">
                    <div class="flex justify-between items-start flex-wrap gap-2">
                        <h3 class="font-headline-md text-headline-md font-bold text-on-surface uppercase">Full-Stack Developer</h3>
                        <span class="font-label-caps text-label-caps bg-on-surface text-surface-container-lowest px-2 py-1">INTERNSHIP</span>
                    </div>
                    <h4 class="font-body-lg text-body-lg text-on-surface-variant mt-2">School Attendance System</h4>
                </div>
                <div class="p-4 bg-surface-container-lowest">
                    <ul class="space-y-3">
                        <li class="font-body-md text-body-md text-on-surface flex items-start border-b-[4px] border-on-surface pb-2 border-opacity-20 hover:bg-secondary-fixed transition-colors">
                            <span class="material-symbols-outlined mr-2 shrink-0 fill" style="font-variation-settings: 'FILL' 1;" data-icon="square">square</span>
                            Membangun sistem absensi lengkap untuk guru dan murid yang dilengkapi dengan fitur rekap laporan dalam format Excel.
                        </li>
                        <li class="font-body-md text-body-md text-on-surface flex items-start border-b-[4px] border-on-surface pb-2 border-opacity-20 hover:bg-secondary-fixed transition-colors">
                            <span class="material-symbols-outlined mr-2 shrink-0 fill" style="font-variation-settings: 'FILL' 1;" data-icon="square">square</span>
                            Menambahkan modul pendaftaran siswa baru dan berhasil melakukan deploy aplikasi di server InfinityFree.
                        </li>
                    </ul>
                    <div class="mt-4 flex flex-wrap gap-2">
                        <span class="font-label-caps text-label-caps bg-secondary text-on-secondary border-[2px] border-on-surface px-2 py-1">PHP</span>
                        <span class="font-label-caps text-label-caps bg-secondary text-on-secondary border-[2px] border-on-surface px-2 py-1">MySQL</span>
                        <span class="font-label-caps text-label-caps bg-secondary text-on-secondary border-[2px] border-on-surface px-2 py-1">Excel Export</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline Item 3: Right Side (Desktop) -->
        <div class="relative flex md:justify-end items-center w-full mb-16 pl-12 md:pl-0 z-10 group reveal" style="transition-delay: 400ms;">
            <!-- Stem Connector -->
            <div class="absolute left-[16px] md:left-1/2 w-8 md:w-16 h-[8px] bg-on-surface md:-translate-x-full"></div>
            <!-- Node Marker -->
            <div class="absolute left-[16px] md:left-1/2 w-6 h-6 bg-surface border-[4px] border-on-surface rounded-none -translate-x-1/2 -translate-y-1/2 top-1/2 z-20 group-hover:bg-secondary-fixed transition-colors"></div>
            
            <div class="w-full md:w-[calc(50%-48px)] bg-surface-container-lowest border-[4px] border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] neo-interactive cursor-default hover:bg-surface-bright">
                <div class="border-b-[4px] border-on-surface p-4 bg-surface-container-high">
                    <div class="flex justify-between items-start flex-wrap gap-2">
                        <h3 class="font-headline-md text-headline-md font-bold text-on-surface uppercase">Software Engineer / Researcher</h3>
                        <span class="font-label-caps text-label-caps bg-on-surface text-surface-container-lowest px-2 py-1">FINAL PROJECT</span>
                    </div>
                    <h4 class="font-body-lg text-body-lg text-on-surface-variant mt-2">Sinta 3 Journal Publication</h4>
                </div>
                <div class="p-4 bg-surface-container-lowest">
                    <ul class="space-y-3">
                        <li class="font-body-md text-body-md text-on-surface flex items-start border-b-[4px] border-on-surface pb-2 border-opacity-20 hover:bg-secondary-fixed transition-colors">
                            <span class="material-symbols-outlined mr-2 shrink-0 fill" style="font-variation-settings: 'FILL' 1;" data-icon="square">square</span>
                            Mengembangkan aplikasi pencarian rute rumah sakit menggunakan Algoritma A* (A-Star) untuk penentuan jalur optimal.
                        </li>
                    </ul>
                    <div class="mt-4 flex flex-wrap gap-4">
                        <a href="https://go-pai.github.io/rute-rumah-sakit/" target="_blank" class="bg-tertiary text-on-tertiary border-[2px] border-on-surface shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] px-4 py-2 font-bold no-underline hover:bg-secondary-fixed hover:text-on-surface transition-colors uppercase text-sm">
                            Demo Aplikasi
                        </a>
                        <a href="https://jurnal.itg.ac.id/index.php/algoritma/article/view/2397/1864" target="_blank" class="bg-surface-container-highest text-on-surface border-[2px] border-on-surface shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] px-4 py-2 font-bold no-underline hover:bg-secondary hover:text-on-secondary transition-colors uppercase text-sm">
                            Baca Jurnal (Sinta 3)
                        </a>
                    </div>
                    <div class="mt-6 flex flex-wrap gap-2">
                        <span class="font-label-caps text-label-caps bg-tertiary text-on-tertiary border-[2px] border-on-surface px-2 py-1">A* Algorithm</span>
                        <span class="font-label-caps text-label-caps bg-tertiary text-on-tertiary border-[2px] border-on-surface px-2 py-1">JavaScript</span>
                        <span class="font-label-caps text-label-caps bg-tertiary text-on-tertiary border-[2px] border-on-surface px-2 py-1">GitHub Pages</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    // Intersection Observer for scroll animations
    const observeTimeline = () => {
        const reveals = document.querySelectorAll("#experience .reveal");
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("active");
                } else {
                    entry.target.classList.remove("active");
                }
            });
        }, { threshold: 0.1 });
        
        reveals.forEach(reveal => {
            observer.observe(reveal);
        });
    };

    document.addEventListener("DOMContentLoaded", observeTimeline);
    document.addEventListener("astro:page-load", observeTimeline);
</script>
