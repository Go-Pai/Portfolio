---

---

<section
  id="home"
  class="pt-[120px] pb-[80px] px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto min-h-[calc(100vh-100px)] flex items-center overflow-x-hidden"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter w-full">
    <!-- Left Column: Typography & Action -->
    <div
      class="col-span-1 md:col-span-7 flex flex-col justify-center order-2 md:order-1 relative z-10 animate-fade-blur"
    >
      <!-- Drafting Crosshairs Detail -->
      <div class="absolute -top-6 -left-6 w-8 h-8 opacity-50 hidden md:block">
        <div class="w-full h-px bg-on-surface absolute top-1/2"></div>
        <div class="h-full w-px bg-on-surface absolute left-1/2"></div>
      </div>
      <div
        class="bg-surface-container-lowest border-border-width border-on-surface p-grid-unit inline-block mb-4 w-fit shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]"
      >
        <span
          class="font-mono-data text-mono-data text-on-surface uppercase tracking-widest font-bold"
          >SYS.STATUS: ONLINE</span
        >
      </div>
      <h1
        class="font-display-xl text-headline-lg-mobile md:text-display-xl text-on-surface mb-2 font-bold uppercase leading-none max-w-2xl"
      >
        Hello, welcome to my website..
      </h1>
      <h2
        class="font-headline-lg text-headline-md md:text-headline-lg text-primary bg-secondary-fixed inline-block w-fit px-2 border-y-[4px] border-on-surface mb-8"
      >
        <span
          id="rotating-text"
          class="inline-block transition-opacity duration-300">Frontend</span
        >
      </h2>
      <div class="flex flex-wrap gap-4 mt-2">
        <a
          href="https://drive.google.com/file/d/1fA7ui23O7HbiQ7qDJYq_IkmY6SboWC4h/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-neo bg-primary text-on-primary font-headline-md text-headline-md px-8 py-4 border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex items-center gap-2 cursor-pointer no-underline hover:bg-primary-fixed transition-colors"
        >
          Download CV
          <span
            class="material-symbols-outlined"
            style="font-variation-settings: 'FILL' 1;">download</span
          >
        </a>
        <a
          href="https://github.com/Go-Pai"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-neo bg-surface text-on-surface font-headline-md text-headline-md px-6 py-4 border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex items-center gap-2 cursor-pointer no-underline hover:bg-secondary-fixed transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-6 h-6 text-[#1A1A1A]"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/vitoadyatma"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-neo bg-[#0077b5] text-white font-headline-md text-headline-md px-6 py-4 border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex items-center gap-2 cursor-pointer no-underline hover:bg-[#005f93] transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="w-6 h-6 text-white"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>
    <!-- Right Column: Profile Image -->
    <div
      class="col-span-1 md:col-span-5 flex items-center justify-center order-1 md:order-2 mb-12 md:mb-0 animate-slide-left"
    >
      <div
        class="relative w-full max-w-[400px] h-[450px] mx-auto flex items-end justify-center"
      >
        <!-- Circular background -->
        <div
          class="absolute bottom-4 w-[280px] h-[280px] md:w-[320px] md:h-[320px] rounded-full bg-secondary-fixed border-[4px] border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] z-0"
        >
        </div>
        <!-- The Image popping out -->
        <img
          class="relative z-10 w-[260px] md:w-[300px] object-contain drop-shadow-[8px_8px_0px_rgba(0,0,0,1)]"
          alt="go-vay"
          src="/images/my-photo.png"
        />

        <!-- Digital Tape Stickers -->
        <div class="tape-tl z-20"></div>
        <!-- Coordinate overlay -->
        <div
          class="absolute bottom-0 right-4 z-20 bg-surface-container-lowest border-border-width border-on-surface px-2 py-1 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] rounded-full"
        >
          <span class="font-mono-data text-label-caps font-bold"
            >X:104 Y:88 Z:0</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .animate-fade-blur {
    animation: fadeBlur 1s ease-out forwards;
  }

  .animate-slide-left {
    animation: slideLeft 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes fadeBlur {
    0% {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @keyframes slideLeft {
    0% {
      opacity: 0;
      transform: translateX(100%);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<script>
  const roles = ["Frontend Developer", "Web Developer", "Vue & React", "Astro & Tailwind"];
  let currentIndex = 0;
  const textElement = document.getElementById("rotating-text");

  if (textElement) {
    setInterval(() => {
      textElement.style.opacity = "0";
      setTimeout(() => {
        currentIndex = (currentIndex + 1) % roles.length;
        textElement.innerText = roles[currentIndex];
        textElement.style.opacity = "1";
      }, 300); // Wait for fade out
    }, 3000); // Change every 3 seconds
  }
</script>
