---
---
<section id="education" class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-margin-desktop">
    <header class="mb-margin-desktop reveal">
        <h1 class="font-display-xl text-display-xl text-on-surface uppercase mb-4">ACADEMIC BACKGROUND</h1>
        <p class="font-mono-data text-mono-data text-on-surface-variant max-w-2xl bg-secondary-fixed p-2 inline-block border-[2px] border-on-surface">EDUCATION LOG & FORMAL TRAINING</p>
    </header>

    <!-- Accordion Container -->
    <div class="w-full flex flex-col md:flex-row h-[850px] md:h-[550px] border-[4px] border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] bg-surface-container-lowest reveal" style="transition-delay: 200ms;">
        
        <!-- Panel 2: High School (Kiri) -->
        <article class="accordion-panel group flex-1 hover:flex-[2] md:hover:flex-[3] transition-all duration-700 ease-in-out border-b-[4px] md:border-b-0 md:border-r-[4px] border-on-surface bg-surface-container-lowest overflow-hidden relative cursor-pointer">
            
            <!-- Logo (Kecil default, membesar saat hover) -->
            <img src="/images/logo-sma.png" alt="Logo SMA" class="absolute top-6 md:top-8 right-6 md:right-8 w-16 h-16 md:w-20 md:h-20 group-hover:w-40 group-hover:h-40 md:group-hover:w-[280px] md:group-hover:h-[280px] group-hover:top-1/2 group-hover:-translate-y-1/2 object-contain transition-all duration-700 ease-in-out z-0 opacity-50 group-hover:opacity-100 drop-shadow-[4px_4px_0px_rgba(0,0,0,1)] group-hover:drop-shadow-[8px_8px_0px_rgba(0,0,0,1)]" onerror="this.style.display='none'">

            <div class="absolute inset-0 p-6 md:p-8 flex flex-col justify-between w-[350px] md:w-[450px] z-10">
                <!-- Top Section: Number and Year -->
                <div>
                    <h2 class="font-display-xl text-6xl md:text-8xl font-black text-secondary opacity-30 group-hover:opacity-60 transition-opacity duration-500 drop-shadow-[4px_4px_0px_rgba(0,0,0,1)] uppercase">02</h2>
                    <span class="inline-block bg-secondary text-on-secondary font-label-caps text-label-caps px-3 py-1 border-[2px] border-on-surface mt-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase font-bold">2019 - 2022</span>
                </div>
                
                <!-- Bottom Section: Title and Details -->
                <div class="mt-auto">
                    <h3 class="font-display-xl text-headline-md md:text-headline-lg font-bold text-on-surface group-hover:text-secondary transition-colors duration-500 mb-2 uppercase leading-none">SMA Negeri 2<br>Rejang Lebong</h3>
                    
                    <!-- Expandable Content -->
                    <div class="opacity-0 max-h-0 md:-translate-y-4 group-hover:translate-y-0 group-hover:opacity-100 group-hover:max-h-[200px] transition-all duration-500 ease-in-out mt-4">
                        <div class="flex gap-2 mb-4">
                            <span class="border-[2px] border-on-surface bg-secondary-fixed px-3 py-1 text-sm font-bold uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">Jurusan IPA</span>
                        </div>
                    </div>
                </div>
            </div>
        </article>

        <!-- Panel 1: University (Kanan) -->
        <article class="accordion-panel group flex-1 hover:flex-[2.5] md:hover:flex-[4] transition-all duration-700 ease-in-out bg-surface overflow-hidden relative cursor-pointer">
            
            <!-- Logo (Kecil default, membesar saat hover) -->
            <img src="/images/logo-kampus.png" alt="Logo Kampus" class="absolute top-6 md:top-8 right-6 md:right-8 w-16 h-16 md:w-20 md:h-20 group-hover:w-40 group-hover:h-40 md:group-hover:w-[280px] md:group-hover:h-[280px] group-hover:top-1/2 group-hover:-translate-y-1/2 object-contain transition-all duration-700 ease-in-out z-0 opacity-50 group-hover:opacity-100 drop-shadow-[4px_4px_0px_rgba(0,0,0,1)] group-hover:drop-shadow-[8px_8px_0px_rgba(0,0,0,1)]" onerror="this.style.display='none'">

            <div class="absolute inset-0 p-6 md:p-8 flex flex-col justify-between w-[350px] md:w-[600px] z-10">
                <!-- Top Section: Number and Year -->
                <div>
                    <h2 class="font-display-xl text-6xl md:text-8xl font-black text-primary opacity-30 group-hover:opacity-60 transition-opacity duration-500 drop-shadow-[4px_4px_0px_rgba(0,0,0,1)] uppercase">01</h2>
                    <span class="inline-block bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 border-[2px] border-on-surface mt-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase font-bold">2022 - 2025</span>
                </div>
                
                <!-- Bottom Section: Title and Details -->
                <div class="mt-auto">
                    <h3 class="font-display-xl text-headline-md md:text-headline-lg font-bold text-on-surface group-hover:text-primary transition-colors duration-500 mb-2 uppercase leading-none">Universitas Muhammadiyah<br>Bengkulu</h3>
                    
                    <!-- Expandable Content -->
                    <div class="opacity-0 max-h-0 md:-translate-y-4 group-hover:translate-y-0 group-hover:opacity-100 group-hover:max-h-[500px] transition-all duration-500 ease-in-out mt-4">
                        
                        <div class="flex flex-wrap gap-2 mb-4">
                            <span class="border-[2px] border-on-surface bg-surface-container-lowest px-2 py-1 text-xs font-bold uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">Fakultas Teknik</span>
                            <span class="border-[2px] border-on-surface bg-surface-container-lowest px-2 py-1 text-xs font-bold uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">Prodi Informatika</span>
                            <span class="border-[2px] border-on-surface bg-primary px-2 py-1 text-xs font-bold uppercase text-on-primary shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">IPK: 3.87</span>
                        </div>

                        <p class="font-body-sm font-bold text-on-surface mb-2 border-b-[2px] border-on-surface inline-block pb-1">Mata kuliah yang diminati:</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <div class="flex items-center gap-2 border-[2px] border-on-surface bg-surface-container-lowest p-2 hover:bg-primary-fixed transition-colors">
                                <span class="material-symbols-outlined text-sm">terminal</span>
                                <span class="font-mono-data text-xs font-bold">Algoritma Pemrograman</span>
                            </div>
                            <div class="flex items-center gap-2 border-[2px] border-on-surface bg-surface-container-lowest p-2 hover:bg-secondary-fixed transition-colors">
                                <span class="material-symbols-outlined text-sm">security</span>
                                <span class="font-mono-data text-xs font-bold">System & Network Security</span>
                            </div>
                            <div class="flex items-center gap-2 border-[2px] border-on-surface bg-surface-container-lowest p-2 hover:bg-tertiary-fixed transition-colors">
                                <span class="material-symbols-outlined text-sm">key</span>
                                <span class="font-mono-data text-xs font-bold">Cryptography</span>
                            </div>
                            <div class="flex items-center gap-2 border-[2px] border-on-surface bg-surface-container-lowest p-2 hover:bg-primary-fixed transition-colors">
                                <span class="material-symbols-outlined text-sm">architecture</span>
                                <span class="font-mono-data text-xs font-bold">Systems Analysis & Design</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </article>

    </div>
</section>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(40px);
        transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
    }
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    .accordion-panel {
        min-width: 0; 
    }
    
    @media (max-width: 768px) {
        .accordion-panel:hover {
            flex-grow: 2.5;
        }
    }
</style>

<script>
    // Intersection Observer for scroll animations
    const observeEdu = () => {
        const reveals = document.querySelectorAll("#education .reveal");
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("active");
                } else {
                    entry.target.classList.remove("active");
                }
            });
        }, { threshold: 0.1 });
        
        reveals.forEach(reveal => {
            observer.observe(reveal);
        });
    };

    document.addEventListener("DOMContentLoaded", observeEdu);
    document.addEventListener("astro:page-load", observeEdu);
</script>
