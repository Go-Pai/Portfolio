<section
  id="contact"
  class="pt-[120px] pb-margin-desktop px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto w-full"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
    <!-- Context Header -->
    <div
