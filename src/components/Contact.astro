    >
      <!-- Drafting Corners -->
      <div
        class="absolute top-0 left-0 w-4 h-4 border-b-[2px] border-r-[2px] border-on-surface"
      >
      </div>
      <div
        class="absolute top-0 right-0 w-4 h-4 border-b-[2px] border-l-[2px] border-on-surface"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-4 h-4 border-t-[2px] border-r-[2px] border-on-surface"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-4 h-4 border-t-[2px] border-l-[2px] border-on-surface"
      >
      </div>

      <h1
        class="font-display-xl text-display-xl mb-grid-unit uppercase text-on-surface break-words"
