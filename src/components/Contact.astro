              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-8 h-8 text-[#1A1A1A] group-hover:text-white transition-colors"
            >
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div
      class="md:col-span-7 bg-surface-container-lowest border-[4px] border-on-surface p-gutter neobrutal-shadow relative mt-gutter md:mt-0 reveal-right"
      style="transition-delay: 200ms;"
    >
      <form
        action="https://api.web3forms.com/submit"
        class="space-y-gutter flex flex-col h-full"
        method="POST"
      >
        <input
          type="hidden"
          name="access_key"
          value="68f8316e-411d-4cfc-a207-483f2d138f4d"
        />
        <div class="space-y-2">
          <label
            class="block font-label-caps text-label-caps uppercase text-on-surface font-bold"
            for="name">Client Designation [Name]</label
          >
          <input
            class="w-full bg-surface-container-lowest border-[4px] border-on-surface p-4 font-mono-data text-mono-data focus:outline-none focus:ring-0 focus:bg-primary-fixed focus:border-on-surface neobrutal-input-shadow transition-colors placeholder-on-surface-variant/50"
            id="name"
            name="name"
            placeholder="ENTER_NAME..."
            required=""
            type="text"
          />
        </div>
        <div class="space-y-2">
          <label
            class="block font-label-caps text-label-caps uppercase text-on-surface font-bold"
            for="email">Return Vector [Email]</label
          >
          <input
            class="w-full bg-surface-container-lowest border-[4px] border-on-surface p-4 font-mono-data text-mono-data focus:outline-none focus:ring-0 focus:bg-primary-fixed focus:border-on-surface neobrutal-input-shadow transition-colors placeholder-on-surface-variant/50"
            id="email"
            name="email"
            placeholder="ENTER_EMAIL..."
            required=""
            type="email"
          />
        </div>
        <div class="space-y-2 flex-grow">
          <label
            class="block font-label-caps text-label-caps uppercase text-on-surface font-bold"
            for="message">Payload [Message]</label
          >
          <textarea
            class="w-full bg-surface-container-lowest border-[4px] border-on-surface p-4 font-mono-data text-mono-data focus:outline-none focus:ring-0 focus:bg-primary-fixed focus:border-on-surface neobrutal-input-shadow transition-colors resize-none placeholder-on-surface-variant/50"
            id="message"
            name="message"
            placeholder="ENTER_MESSAGE_DATA..."
            required=""
            rows="6"></textarea>
        </div>

        <button
          class="w-full bg-secondary-fixed text-on-secondary-fixed border-[4px] border-on-surface py-4 px-8 font-headline-md text-headline-md font-bold uppercase neobrutal-shadow neobrutal-active hover:bg-secondary-fixed-dim transition-colors mt-auto"
          type="submit"
        >
          Execute Transmit
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .reveal-left {
    opacity: 0;
    transform: translateX(-50px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-right {
    opacity: 0;
    transform: translateX(50px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-left.active,
  .reveal-right.active {
    opacity: 1;
    transform: translateX(0);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
        } else {
          entry.target.classList.remove("active");
        }
      });
    },
    {
      threshold: 0.1,
    },
  );

  document
    .querySelectorAll(".reveal-left, .reveal-right, .reveal-bottom")
    .forEach((el) => {
      observer.observe(el);
    });
</script>
