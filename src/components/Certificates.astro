---

---

<section
  id="certificates"
  class="py-margin-desktop px-margin-mobile md:px-margin-desktop max-w-[1280px] mx-auto w-full border-t-border-width border-on-surface"
>
  <header class="mb-gutter md:mb-[64px] inline-block reveal-left">
    <div
      class="border-border-width border-on-surface bg-tertiary-fixed shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] p-gutter"
    >
      <h1 class="font-display-xl text-display-xl uppercase m-0 leading-none">
        Certificates
      </h1>
      <p
        class="font-mono-data text-mono-data mt-grid-unit text-on-surface-variant bg-surface border-[2px] border-on-surface inline-block px-2 py-1 shadow-[2px_2px_0px_rgba(0,0,0,1)]"
      >
        ACHIEVEMENTS // [03_RECORDS]
      </p>
    </div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter max-w-4xl mx-auto">
    <!-- Certificate 1 -->
    <div class="reveal-bottom">
      <article
        class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
      >
        <!-- Image Container -->
        <div
          class="h-56 border-b-border-width border-on-surface overflow-hidden bg-primary-fixed p-4 flex items-center justify-center"
        >
          <img
            class="w-full h-full object-contain border-[2px] border-on-surface shadow-[4px_4px_0px_rgba(0,0,0,1)] group-hover:scale-[1.02] transition-transform duration-300"
            alt="Certificate 1"
            src="/images/cert-1.jpg"
          />
        </div>

        <div class="p-gutter flex flex-col flex-grow">
          <!-- Date / Month -->
          <div class="mb-3">
            <span
              class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1 shadow-[2px_2px_0px_rgba(0,0,0,1)]"
              >AGUSTUS 2024</span
            >
          </div>

          <!-- Certificate Title -->
          <h2
            class="font-headline-md text-headline-md font-bold uppercase mb-2 text-on-surface"
          >
            Workshop Nasional Technopreneurship
          </h2>

          <!-- Issuer -->
          <p
            class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow font-semibold"
          >
            Diterbitkan oleh: <span class="text-on-surface"
              >Fakultas Teknik UMB &amp; PT. Jago Multidimensi</span
            >
          </p>

          <!-- GDrive Link -->
          <div
            class="flex mt-auto border-t-border-width border-on-surface pt-grid-unit"
          >
            <a
              href="https://drive.google.com/file/d/14eHOf2l2pqBSayzK9nTd-6EN2NK0rAox/view?usp=sharing"
              target="_blank"
              class="w-full bg-secondary text-on-secondary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-secondary-fixed hover:text-on-surface transition-all flex justify-center items-center gap-2 text-decoration-none"
            >
              <span class="material-symbols-outlined">folder_open</span> Lihat Selengkapnya
            </a>
          </div>
        </div>
      </article>
    </div>

    <!-- Certificate 2 -->
    <div class="reveal-bottom" style="transition-delay: 150ms;">
      <article
        class="bg-surface-container-lowest border-border-width border-on-surface shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full group hover:-translate-y-grid-unit transition-transform duration-200"
      >
        <div
          class="h-56 border-b-border-width border-on-surface overflow-hidden bg-tertiary-fixed p-4 flex items-center justify-center"
        >
          <img
            class="w-full h-full object-contain border-[2px] border-on-surface shadow-[4px_4px_0px_rgba(0,0,0,1)] group-hover:scale-[1.02] transition-transform duration-300"
            alt="Certificate 2"
            src="/images/cert-2.jpg"
          />
        </div>

        <div class="p-gutter flex flex-col flex-grow">
          <div class="mb-3">
            <span
              class="font-label-caps text-label-caps border-[2px] border-on-surface bg-surface text-on-surface px-2 py-1 shadow-[2px_2px_0px_rgba(0,0,0,1)]"
              >OKTOBER 2024</span
            >
          </div>

          <h2
            class="font-headline-md text-headline-md font-bold uppercase mb-2 text-on-surface"
          >
            Fundamental Jaringan Komputer
          </h2>

          <p
            class="font-body-md text-body-md text-on-surface-variant mb-gutter flex-grow font-semibold"
          >
            Diterbitkan oleh: <span class="text-on-surface">Coding Studio</span>
          </p>

          <div
            class="flex mt-auto border-t-border-width border-on-surface pt-grid-unit"
          >
            <a
              href="https://drive.google.com/file/d/1e2hcp7SzpSN5okie17hVru2PgO8q7IQq/view?usp=sharing"
              target="_blank"
              class="w-full bg-secondary text-on-secondary border-border-width border-on-surface font-headline-md text-headline-md uppercase py-2 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] hover:bg-secondary-fixed hover:text-on-surface transition-all flex justify-center items-center gap-2 text-decoration-none"
            >
              <span class="material-symbols-outlined">folder_open</span> Lihat Selengkapnya
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .reveal-left {
    opacity: 0;
    transform: translateX(-60px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-right {
    opacity: 0;
    transform: translateX(60px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-bottom {
    opacity: 0;
    transform: translateY(60px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal-left.active,
  .reveal-right.active,
  .reveal-bottom.active {
    opacity: 1;
    transform: translate(0);
  }
</style>

<script>
  const observeCertificates = () => {
    const reveals = document.querySelectorAll(
      "#certificates .reveal-left, #certificates .reveal-bottom",
    );
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          } else {
            entry.target.classList.remove("active");
          }
        });
      },
      { threshold: 0.1 },
    );

    reveals.forEach((reveal) => {
      observer.observe(reveal);
    });
  };

  document.addEventListener("DOMContentLoaded", observeCertificates);
  document.addEventListener("astro:page-load", observeCertificates);
</script>
