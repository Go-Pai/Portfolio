<section
  id="about"
  class="container mx-auto px-margin-mobile md:px-margin-desktop py-gutter md:py-margin-desktop flex flex-col justify-center max-w-[1280px]"
>
  <!-- About Section Header -->
  <div class="mb-gutter md:mb-margin-desktop reveal">
    <h1
      class="font-display-xl text-display-xl-mobile md:text-display-xl uppercase text-on-surface neo-border bg-secondary-fixed inline-block px-4 py-2 neo-shadow"
    >
      ABOUT ME
    </h1>
  </div>
  <!-- Bento Grid Layout -->
  <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
    <!-- Left Column: Visual Anchor -->
    <div
      class="md:col-span-5 flex flex-col gap-gutter reveal"
      style="transition-delay: 100ms;"
    >
      <!-- Image Card -->
      <div
        class="neo-border bg-surface-container-lowest p-4 neo-shadow relative drafting-box h-full flex flex-col"
      >
        <div
          class="border-b-[4px] border-on-surface pb-2 mb-4 flex justify-between items-center"
        >
          <span class="font-label-caps text-label-caps uppercase"
            >Visual_Data.img</span
          >
          <span class="material-symbols-outlined" data-icon="terminal"
            >terminal</span
          >
        </div>
        <div
          class="flex-grow relative overflow-hidden bg-surface-container-high border-[2px] border-on-surface group"
        >
          <!-- Neobrutalist ragged edge effect simulated with borders/shadows on an image container -->
          <div
            class="absolute inset-2 border-[4px] border-primary z-10 pointer-events-none transform -rotate-2"
          >
          </div>
          <div
            class="absolute inset-2 border-[4px] border-secondary z-10 pointer-events-none transform rotate-1"
          >
          </div>
          <!-- Added scale-[1.5] to zoom in the image and group-hover:scale-[1.6] for interactive zoom -->
          <img
            class="w-full h-full object-cover relative z-0 scale-[1.5] transition-transform duration-500 group-hover:scale-[1.6]"
            alt="About Photo"
            src="/images/about-photo.jpg"
          />
        </div>
        <div
          class="mt-4 font-mono-data text-mono-data bg-surface-container-high p-2 neo-border"
        >
          &gt; status: operational <br />
          &gt; loc: on-site
        </div>
      </div>
    </div>
    <!-- Right Column: Bio Data -->
    <div
      class="md:col-span-7 flex flex-col gap-gutter reveal"
      style="transition-delay: 300ms;"
    >
      <!-- Main Bio Card -->
      <div
        class="neo-border bg-surface-container-lowest p-margin-mobile md:p-gutter neo-shadow drafting-box"
      >
        <div
          class="border-b-[4px] border-on-surface pb-2 mb-gutter flex items-center gap-2"
        >
          <span
            class="material-symbols-outlined text-primary"
            data-icon="fingerprint">fingerprint</span
          >
          <h2 class="font-headline-md text-headline-md uppercase">ABOUT</h2>
        </div>
        <div class="space-y-6">
          <p class="font-body-lg text-body-lg leading-relaxed">
            Halo, perkenalkan saya Vito Adyatma Yoransa, Sarjana Teknik
            Informatika dari Universitas Muhammadiyah Bengkulu. Saat ini saya berfokus sebagai <strong class="bg-secondary-fixed px-1">
              Frontend & Fullstack Web Developer</strong
            > dengan keahlian dalam membangun antarmuka web yang modern, responsif, dan interaktif, didukung kemampuan end-to-end dalam integrasi sistem dan arsitektur backend.
          </p>
          <p class="font-body-lg text-body-lg leading-relaxed">
            Fokus utama saya mencakup perancangan antarmuka responsif dan rekayasa web menggunakan ekosistem modern seperti Vue.js, React, Astro, dan Tailwind CSS, hingga arsitektur Laravel dan RESTful API. Saya berorientasi pada detail, performa tinggi, serta berkomitmen menghadirkan solusi teknologi yang optimal dan tepat guna.
          </p>
        </div>
        <!-- Tech Chips -->
        <div class="mt-gutter pt-gutter border-t-[4px] border-on-surface">
          <span class="font-label-caps text-label-caps uppercase block mb-4"
            >Functional Parameters:</span
          >
          <div class="flex flex-wrap gap-2">
            <span
              class="bg-secondary-fixed border-[2px] border-on-surface px-3 py-1 font-mono-data text-mono-data font-bold"
              >Responsive UI/UX</span
            >
            <span
              class="bg-primary-fixed border-[2px] border-on-surface px-3 py-1 font-mono-data text-mono-data font-bold"
              >API Architecture</span
            >
            <span
              class="bg-[#d1fae5] border-[2px] border-on-surface px-3 py-1 font-mono-data text-mono-data font-bold"
              >Database & ORM Design</span
            >
            <span
              class="bg-[#e0f2fe] border-[2px] border-on-surface px-3 py-1 font-mono-data text-mono-data font-bold"
              >Docker Containerization</span
            >
            <span
              class="bg-[#ffedd5] border-[2px] border-on-surface px-3 py-1 font-mono-data text-mono-data font-bold"
              >Automated Testing (Pest)</span
            >
            <span
              class="bg-[#f3e8ff] border-[2px] border-on-surface px-3 py-1 font-mono-data text-mono-data font-bold"
              >Spatial Routing (A* Algorithm)</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
  }
  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Intersection Observer for scroll animations
  const observeElements = () => {
    const reveals = document.querySelectorAll(".reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
          } else {
            entry.target.classList.remove("active");
          }
        });
      },
      { threshold: 0.15 },
    );

    reveals.forEach((reveal) => {
      observer.observe(reveal);
    });
  };

  // Run on initial load
  document.addEventListener("DOMContentLoaded", observeElements);
  // Support Astro view transitions if enabled
  document.addEventListener("astro:page-load", observeElements);
</script>
